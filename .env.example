# Usado pelo docker-compose.yml na raiz (Dokploy ou local).
# apps/api/.env.example e apps/web/.env.example têm a lista completa comentada —
# esse arquivo só junta o que o compose precisa num lugar só.

# --- api (env_file) ---
DATABASE_URL=
PORT=4000
APP_URL=
CLIENT_URL=
STORAGE_PROVIDER=LOCAL
UPLOADS_DIR=./uploads
MAX_FILE_SIZE_MB=200

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

AGENT_PASSWORD=
AGENT_SESSION_SECRET=

DEFAULT_CALLBACK_URL=

KOMMO_SUBDOMAIN=
KOMMO_API_TOKEN=

# --- web (build arg, embutido no bundle em tempo de build) ---
VITE_API_URL=
