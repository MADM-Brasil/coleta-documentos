# Local: suba com `docker compose up -d` na raiz do repo (usa este valor por padrão)
# ou use uma instância gratuita (Render, Neon, Supabase). Em produção no Render,
# essa variável é preenchida automaticamente pelo render.yaml a partir do banco "forms-madm-db".
DATABASE_URL="postgresql://forms_madm:forms_madm@localhost:5432/forms_madm"

PORT=4000
APP_URL="http://localhost:4000"
CLIENT_URL="http://localhost:5173"

# LOCAL (disco do servidor, só dev) | CLOUDINARY | R2 (Cloudflare)
STORAGE_PROVIDER="LOCAL"

# Usado apenas quando STORAGE_PROVIDER="LOCAL". Em produção sem disco persistente,
# os arquivos são perdidos a cada deploy/reinício — use CLOUDINARY ou R2 nesse caso.
UPLOADS_DIR="./uploads"

# Necessário apenas quando STORAGE_PROVIDER="CLOUDINARY" (dashboard da Cloudinary).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Necessário apenas quando STORAGE_PROVIDER="R2" (Cloudflare R2 → Manage API Tokens).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

MAX_FILE_SIZE_MB=200

# Opcionais: quando os dois estiverem preenchidos, cada documento enviado é anexado
# diretamente no lead da Kommo (nota nativa, com miniatura/download reais) no momento
# do upload — sem precisar do Make pra essa parte. Gere o token em Kommo → Configurações
# → Integrações → crie uma integração privada → aba "Chaves e escopos" → Long-Lived Token
# (precisa do escopo "Acesso a arquivos").
KOMMO_SUBDOMAIN=
KOMMO_API_TOKEN=

# Opcional: URL fixa para onde TODO evento em tempo real é enviado (documento
# enviado, coleta concluída), independente do que o Make mandar em "callbackUrl"
# na criação da coleta. Ex: gatilho "Custom Webhook" do Make para o HubSpot.
DEFAULT_CALLBACK_URL=
