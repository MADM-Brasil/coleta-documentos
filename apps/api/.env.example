# Local: suba com `docker compose up -d` na raiz do repo (usa este valor por padrão)
# ou use uma instância gratuita (Render, Neon, Supabase). Em produção no Render,
# essa variável é preenchida automaticamente pelo render.yaml a partir do banco "forms-madm-db".
DATABASE_URL="postgresql://forms_madm:forms_madm@localhost:5432/forms_madm"

PORT=4000
APP_URL="http://localhost:4000"
CLIENT_URL="http://localhost:5173"

# Segredo compartilhado com o Make/Integromat para autenticar o webhook.
# Gere um valor aleatório forte em produção (ex: openssl rand -hex 32).
WEBHOOK_SECRET="troque-este-valor-em-producao"

STORAGE_PROVIDER="LOCAL"
# Em produção (Render), aponte para o mount path do disco persistente,
# ex: /var/data/uploads — nunca uma pasta comum, ou os arquivos somem a cada deploy.
UPLOADS_DIR="./uploads"

MAX_FILE_SIZE_MB=200
